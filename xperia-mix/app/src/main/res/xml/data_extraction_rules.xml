<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Le cache PCM decode est volumineux et reconstructible : jamais sauvegarde. -->
        <exclude domain="file" path="pcm" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="pcm" />
    </device-transfer>
</data-extraction-rules>
