<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Aucune permission de stockage : les fichiers sont ouverts via le
         Storage Access Framework (ACTION_OPEN_DOCUMENT), qui accorde un acces
         persistant par URI. READ_MEDIA_AUDIO ne serait necessaire que pour
         parcourir MediaStore soi-meme. -->

    <uses-feature android:name="android.hardware.audio.low_latency" android:required="false" />
    <uses-feature android:name="android.hardware.audio.pro" android:required="false" />

    <application
        android:name=".XperiaMixApp"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.XperiaMix"
        tools:targetApi="35">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density"
            android:launchMode="singleTask"
            android:resizeableActivity="true"
            android:screenOrientation="fullUser"
            android:theme="@style/Theme.XperiaMix">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Ouverture directe d'un fichier audio depuis un explorateur. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
            </intent-filter>
        </activity>

        <!-- Le 21:9 du Xperia 1 V : on autorise explicitement le ratio etendu et
             le mode multi-fenetre (Side Sense / pop-up window). -->
        <meta-data android:name="android.max_aspect" android:value="2.5" />
        <meta-data android:name="android.allow_multiple_resumed_activities" android:value="true" />
    </application>
</manifest>
